erDiagram
    CUSTOMER ||--o{ ORDER : places
    CUSTOMER }|..|{ ADDRESS : "ships to"
    ORDER ||--|{ LINE_ITEM : contains
    PRODUCT ||--o{ LINE_ITEM : "appears in"
    PRODUCT }o--|| CATEGORY : "belongs to"

    CUSTOMER {
        int id PK
        string email UK "login name"
        string full_name
        date created_at
    }
    ORDER {
        int id PK
        int customer_id FK
        string status
        decimal total
    }
    LINE_ITEM {
        int order_id PK, FK
        int product_id PK, FK
        int quantity
        decimal unit_price
    }
    PRODUCT {
        int id PK
        string sku UK
        string name
        int category_id FK
    }
    CATEGORY {
        int id PK
        string name
    }
    ADDRESS {
        int id PK
        string street
        string city
        string country
    }
